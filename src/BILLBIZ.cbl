IDENTIFICATION DIVISION.
PROGRAM-ID. BILLBIZ.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BILL-FIO.cpy".
COPY "BILL-MST.cpy".
COPY "BILL-TRN.cpy".
01  WS-TODAY             PIC 9(08).
01  WS-DUE-NUM           PIC 9(08).
01  WS-TOTAL             PIC S9(13)V99.
01  WS-MST-FOUND         PIC X(01).
01  WS-I                 PIC 9(02).

LINKAGE SECTION.
COPY "BILL-REQ.cpy".

PROCEDURE DIVISION USING BILL-REQ BILL-RES.
0000-MAIN.
    INITIALIZE BILL-RES MST-REC
    SET RES-OK TO TRUE
    MOVE "N" TO WS-MST-FOUND
    MOVE FUNCTION CURRENT-DATE(1:8) TO WS-TODAY

    PERFORM 1000-VALIDATE
    IF RES-OK
        IF REQ-CREATE
            PERFORM 3100-CREATE
        ELSE
            PERFORM 2000-READ-MASTER
            IF RES-OK AND (REQ-VIEW OR REQ-PAY)
                PERFORM 2500-CHECK-OVERDUE
            END-IF
            IF RES-OK
                PERFORM 3000-APPLY-RULES
            END-IF
        END-IF
    END-IF
    IF WS-MST-FOUND = "Y"
        PERFORM 8000-FILL-RESULT
    END-IF
    IF REQ-PAY
        PERFORM 9000-WRITE-LOG
    END-IF
    IF RES-OK
        MOVE "OK" TO RES-MESSAGE
    END-IF
    GOBACK.

*> BR01, BR02, BR03
1000-VALIDATE.
    EVALUATE TRUE
        WHEN REQ-ID = SPACES
            SET RES-BAD-INPUT TO TRUE
            MOVE "BILL ID IS REQUIRED" TO RES-MESSAGE
        WHEN NOT REQ-ACTION-OK
            SET RES-BAD-INPUT TO TRUE
            MOVE "ACTION MUST BE C, P, V OR H" TO RES-MESSAGE
        WHEN (REQ-CREATE OR REQ-PAY)
         AND (NOT REQ-AMOUNT-VALID OR REQ-AMOUNT <= 0)
            SET RES-BAD-INPUT TO TRUE
            MOVE "AMOUNT MUST BE A NUMBER GREATER THAN 0" TO RES-MESSAGE
        WHEN REQ-CREATE AND REQ-NAME = SPACES
            SET RES-BAD-INPUT TO TRUE
            MOVE "CUSTOMER NAME IS REQUIRED" TO RES-MESSAGE
        WHEN REQ-CREATE AND NOT REQ-TYPE-OK
            SET RES-BAD-INPUT TO TRUE
            MOVE "TYPE MUST BE E OR W" TO RES-MESSAGE
        WHEN REQ-CREATE
            PERFORM 1100-CHECK-DUE-DATE
    END-EVALUATE.

1100-CHECK-DUE-DATE.
    IF REQ-DUE-DATE IS NOT NUMERIC
        SET RES-BAD-INPUT TO TRUE
        MOVE "DUE DATE MUST BE YYYYMMDD" TO RES-MESSAGE
        EXIT PARAGRAPH
    END-IF

    MOVE REQ-DUE-DATE TO WS-DUE-NUM
    IF FUNCTION TEST-DATE-YYYYMMDD(WS-DUE-NUM) NOT = 0
        SET RES-BAD-INPUT TO TRUE
        MOVE "DUE DATE IS NOT A VALID DATE" TO RES-MESSAGE
    END-IF.

*> BR05
2000-READ-MASTER.
    MOVE REQ-ID TO MST-ID
    SET FIO-READ TO TRUE
    CALL "BILLFILE" USING BILL-FIO MST-REC TRN-LINE
    EVALUATE TRUE
        WHEN FIO-OK
            MOVE "Y" TO WS-MST-FOUND
        WHEN FIO-NOT-FOUND
            SET RES-NOT-FOUND TO TRUE
            MOVE "BILL NOT FOUND" TO RES-MESSAGE
        WHEN OTHER
            SET RES-SYS-ERROR TO TRUE
            MOVE "CANNOT READ BILLS FILE" TO RES-MESSAGE
    END-EVALUATE.

*> BR06, BR07: chi chuyen tu UNPAID nen phu phi chi cong 1 lan
2500-CHECK-OVERDUE.
    IF MST-UNPAID AND WS-TODAY > MST-DUE-DATE
        SET MST-OVERDUE TO TRUE
        COMPUTE MST-SURCHARGE ROUNDED = MST-AMOUNT * 0.05
        PERFORM 3900-SAVE-MASTER
    END-IF.

3000-APPLY-RULES.
    EVALUATE TRUE
        WHEN REQ-PAY      PERFORM 3200-PAY
        WHEN REQ-HISTORY  PERFORM 3300-HISTORY
        WHEN REQ-VIEW     CONTINUE
    END-EVALUATE.

*> BR04
3100-CREATE.
    MOVE REQ-ID TO MST-ID
    MOVE REQ-NAME TO MST-NAME
    MOVE REQ-TYPE TO MST-TYPE
    MOVE REQ-AMOUNT TO MST-AMOUNT
    MOVE 0 TO MST-SURCHARGE
    MOVE WS-DUE-NUM TO MST-DUE-DATE
    SET MST-UNPAID TO TRUE
    SET FIO-ADD TO TRUE
    CALL "BILLFILE" USING BILL-FIO MST-REC TRN-LINE
    EVALUATE TRUE
        WHEN FIO-OK
            MOVE "Y" TO WS-MST-FOUND
        WHEN FIO-DUPLICATE
            SET RES-DUPLICATE TO TRUE
            MOVE "BILL ID ALREADY EXISTS" TO RES-MESSAGE
        WHEN OTHER
            SET RES-SYS-ERROR TO TRUE
            MOVE "CANNOT WRITE BILLS FILE" TO RES-MESSAGE
    END-EVALUATE.

*> BR08 kiem truoc BR09
3200-PAY.
    COMPUTE WS-TOTAL = MST-AMOUNT + MST-SURCHARGE
    EVALUATE TRUE
        WHEN MST-PAID
            SET RES-ALREADY-PAID TO TRUE
            MOVE "BILL IS ALREADY PAID" TO RES-MESSAGE
        WHEN REQ-AMOUNT NOT = WS-TOTAL
            SET RES-WRONG-AMOUNT TO TRUE
            MOVE "AMOUNT MUST EQUAL TOTAL DUE" TO RES-MESSAGE
        WHEN OTHER
            SET MST-PAID TO TRUE
            PERFORM 3900-SAVE-MASTER
    END-EVALUATE.

3300-HISTORY.
    SET FIO-HISTORY TO TRUE
    CALL "BILLFILE" USING BILL-FIO MST-REC TRN-LINE
    IF NOT FIO-OK
        SET RES-SYS-ERROR TO TRUE
        MOVE "CANNOT READ HISTORY FILE" TO RES-MESSAGE
        EXIT PARAGRAPH
    END-IF

    MOVE FIO-HIST-COUNT TO RES-HIST-COUNT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > FIO-HIST-COUNT
        MOVE FIO-HIST-LINE(WS-I) TO RES-HIST-LINE(WS-I)
    END-PERFORM.

3900-SAVE-MASTER.
    SET FIO-REWRITE TO TRUE
    CALL "BILLFILE" USING BILL-FIO MST-REC TRN-LINE
    IF NOT FIO-OK
        SET RES-SYS-ERROR TO TRUE
        MOVE "CANNOT UPDATE BILLS FILE" TO RES-MESSAGE
    END-IF.

8000-FILL-RESULT.
    MOVE MST-NAME TO RES-NAME
    MOVE MST-TYPE TO RES-TYPE
    MOVE MST-STATUS TO RES-STATUS
    MOVE MST-AMOUNT TO RES-AMOUNT
    MOVE MST-SURCHARGE TO RES-SURCHARGE
    COMPUTE RES-TOTAL = MST-AMOUNT + MST-SURCHARGE
    MOVE MST-DUE-DATE TO RES-DUE-DATE.

*> BR10: P luon ghi log, ke ca khi loi
9000-WRITE-LOG.
    MOVE FUNCTION CURRENT-DATE(1:8) TO TRN-DATE
    MOVE FUNCTION CURRENT-DATE(9:6) TO TRN-TIME
    MOVE REQ-ID TO TRN-ID
    MOVE REQ-ACTION TO TRN-ACTION
    MOVE REQ-AMOUNT TO TRN-AMOUNT
    MOVE RES-CODE TO TRN-RESULT
    MOVE MST-STATUS TO TRN-STATUS
    SET FIO-LOG TO TRUE
    CALL "BILLFILE" USING BILL-FIO MST-REC TRN-LINE.

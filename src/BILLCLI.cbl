IDENTIFICATION DIVISION.
PROGRAM-ID. BILLCLI.

DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "BILL-REQ.cpy".
01  WS-AMOUNT-IN         PIC X(20).
01  WS-MONEY-OUT         PIC -(13)9.99.
01  WS-I                 PIC 9(02).

PROCEDURE DIVISION.
0000-MAIN.
    INITIALIZE BILL-REQ BILL-RES
    DISPLAY "ACTION (C/P/V/H): " WITH NO ADVANCING
    ACCEPT REQ-ACTION
    DISPLAY "BILL ID: " WITH NO ADVANCING
    ACCEPT REQ-ID
    DISPLAY "AMOUNT: " WITH NO ADVANCING
    ACCEPT WS-AMOUNT-IN
    DISPLAY "CUSTOMER NAME (C): " WITH NO ADVANCING
    ACCEPT REQ-NAME
    DISPLAY "TYPE E/W (C): " WITH NO ADVANCING
    ACCEPT REQ-TYPE
    DISPLAY "DUE DATE YYYYMMDD (C): " WITH NO ADVANCING
    ACCEPT REQ-DUE-DATE

    IF FUNCTION TEST-NUMVAL(WS-AMOUNT-IN) = 0
        COMPUTE REQ-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-IN)
        SET REQ-AMOUNT-VALID TO TRUE
    END-IF

    CALL "BILLBIZ" USING BILL-REQ BILL-RES

    DISPLAY " "
    DISPLAY "RESULT   : " RES-CODE " " FUNCTION TRIM(RES-MESSAGE)
    IF RES-NAME NOT = SPACES
        DISPLAY "CUSTOMER : " FUNCTION TRIM(RES-NAME) " (" RES-TYPE ")"
        DISPLAY "STATUS   : " RES-STATUS "  DUE " RES-DUE-DATE
        MOVE RES-AMOUNT TO WS-MONEY-OUT
        DISPLAY "AMOUNT   : " FUNCTION TRIM(WS-MONEY-OUT)
        MOVE RES-SURCHARGE TO WS-MONEY-OUT
        DISPLAY "SURCHARGE: " FUNCTION TRIM(WS-MONEY-OUT)
        MOVE RES-TOTAL TO WS-MONEY-OUT
        DISPLAY "TOTAL DUE: " FUNCTION TRIM(WS-MONEY-OUT)
    END-IF
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > RES-HIST-COUNT
        DISPLAY "  " RES-HIST-LINE(WS-I)
    END-PERFORM
    STOP RUN.

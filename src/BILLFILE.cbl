IDENTIFICATION DIVISION.
PROGRAM-ID. BILLFILE.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT MASTER-FILE ASSIGN TO "BILLMST"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS F-MST-KEY
        FILE STATUS IS WS-MST-STATUS.
    SELECT OPTIONAL TRAN-FILE ASSIGN TO "BILLTRN"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-TRN-STATUS.

DATA DIVISION.
FILE SECTION.
FD  MASTER-FILE.
01  F-MST-REC.
    05  F-MST-KEY        PIC X(10).
    05  FILLER           PIC X(90).

FD  TRAN-FILE.
01  F-TRN-REC            PIC X(80).

WORKING-STORAGE SECTION.
01  WS-MST-STATUS        PIC X(02).
01  WS-TRN-STATUS        PIC X(02).
01  WS-EOF               PIC X(01).
01  WS-I                 PIC 9(02).

LINKAGE SECTION.
COPY "BILL-FIO.cpy".
COPY "BILL-MST.cpy".
COPY "BILL-TRN.cpy".

PROCEDURE DIVISION USING BILL-FIO MST-REC TRN-LINE.
0000-MAIN.
    EVALUATE TRUE
        WHEN FIO-READ     PERFORM 1000-READ
        WHEN FIO-REWRITE  PERFORM 2000-REWRITE
        WHEN FIO-ADD      PERFORM 2500-ADD
        WHEN FIO-LOG      PERFORM 3000-LOG
        WHEN FIO-HISTORY  PERFORM 4000-HISTORY
        WHEN OTHER        MOVE "99" TO FIO-STATUS
    END-EVALUATE
    GOBACK.

*> doc 1 hoa don theo MST-ID
1000-READ.
    OPEN INPUT MASTER-FILE
    IF WS-MST-STATUS NOT = "00"
        MOVE WS-MST-STATUS TO FIO-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE MST-ID TO F-MST-KEY
    READ MASTER-FILE INTO MST-REC KEY IS F-MST-KEY
        INVALID KEY CONTINUE
    END-READ
    MOVE WS-MST-STATUS TO FIO-STATUS
    CLOSE MASTER-FILE.

*> ghi de hoa don da sua (trang thai, phu phi)
2000-REWRITE.
    OPEN I-O MASTER-FILE
    IF WS-MST-STATUS NOT = "00"
        MOVE WS-MST-STATUS TO FIO-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE MST-REC TO F-MST-REC
    REWRITE F-MST-REC
        INVALID KEY CONTINUE
    END-REWRITE
    MOVE WS-MST-STATUS TO FIO-STATUS
    CLOSE MASTER-FILE.

*> ghi hoa don moi, trung ma thi status 22
2500-ADD.
    OPEN I-O MASTER-FILE
    IF WS-MST-STATUS NOT = "00"
        MOVE WS-MST-STATUS TO FIO-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE MST-REC TO F-MST-REC
    WRITE F-MST-REC
        INVALID KEY CONTINUE
    END-WRITE
    MOVE WS-MST-STATUS TO FIO-STATUS
    CLOSE MASTER-FILE.

*> ghi them 1 dong vao cuoi file log
3000-LOG.
    OPEN EXTEND TRAN-FILE
    IF WS-TRN-STATUS NOT = "00" AND WS-TRN-STATUS NOT = "05"
        MOVE WS-TRN-STATUS TO FIO-STATUS
        EXIT PARAGRAPH
    END-IF

    WRITE F-TRN-REC FROM TRN-LINE
    MOVE WS-TRN-STATUS TO FIO-STATUS
    CLOSE TRAN-FILE.

*> doc het file log, giu lai 10 dong gan nhat cua MST-ID
4000-HISTORY.
    MOVE 0 TO FIO-HIST-COUNT
    OPEN INPUT TRAN-FILE
    IF WS-TRN-STATUS NOT = "00" AND WS-TRN-STATUS NOT = "05"
        MOVE WS-TRN-STATUS TO FIO-STATUS
        EXIT PARAGRAPH
    END-IF

    MOVE "N" TO WS-EOF
    PERFORM UNTIL WS-EOF = "Y"
        READ TRAN-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM 4100-KEEP-LINE
        END-READ
    END-PERFORM
    MOVE "00" TO FIO-STATUS
    CLOSE TRAN-FILE.

*> ID nam o vi tri 17-26 cua dong log (ngay 8 + ; + gio 6 + ;)
4100-KEEP-LINE.
    IF F-TRN-REC(17:10) NOT = MST-ID
        EXIT PARAGRAPH
    END-IF

    IF FIO-HIST-COUNT = 10
        PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > 9
            MOVE FIO-HIST-LINE(WS-I + 1) TO FIO-HIST-LINE(WS-I)
        END-PERFORM
    ELSE
        ADD 1 TO FIO-HIST-COUNT
    END-IF
    MOVE F-TRN-REC TO FIO-HIST-LINE(FIO-HIST-COUNT).

IDENTIFICATION DIVISION.
PROGRAM-ID. BILLLOAD.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT SEED-FILE ASSIGN TO "BILLSEED"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-SEED-STATUS.
    SELECT MASTER-FILE ASSIGN TO "BILLMST"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS F-MST-KEY
        FILE STATUS IS WS-MST-STATUS.

DATA DIVISION.
FILE SECTION.
FD  SEED-FILE.
01  SEED-LINE            PIC X(200).

FD  MASTER-FILE.
01  F-MST-REC.
    05  F-MST-KEY        PIC X(10).
    05  FILLER           PIC X(90).

WORKING-STORAGE SECTION.
COPY "BILL-MST.cpy".
01  WS-SEED-STATUS       PIC X(02).
01  WS-MST-STATUS        PIC X(02).
01  WS-EOF               PIC X(01) VALUE "N".
01  WS-AMOUNT-TXT        PIC X(20).
01  WS-DUE-TXT           PIC X(08).
01  WS-COUNT             PIC 9(05) VALUE 0.

PROCEDURE DIVISION.
0000-MAIN.
    OPEN INPUT SEED-FILE
    IF WS-SEED-STATUS NOT = "00"
        DISPLAY "CANNOT OPEN SEED FILE, STATUS " WS-SEED-STATUS
        STOP RUN
    END-IF

    OPEN OUTPUT MASTER-FILE
    IF WS-MST-STATUS NOT = "00"
        DISPLAY "CANNOT CREATE MASTER FILE, STATUS " WS-MST-STATUS
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF = "Y"
        READ SEED-FILE
            AT END MOVE "Y" TO WS-EOF
            NOT AT END PERFORM 1000-LOAD-ONE
        END-READ
    END-PERFORM

    CLOSE SEED-FILE MASTER-FILE
    DISPLAY "LOADED " WS-COUNT " BILLS"
    STOP RUN.

*> 1 dong seed: ID;TEN;LOAI;SO TIEN;HAN THANH TOAN;TRANG THAI
1000-LOAD-ONE.
    IF SEED-LINE = SPACES
        EXIT PARAGRAPH
    END-IF

    INITIALIZE MST-REC
    UNSTRING SEED-LINE DELIMITED BY ";"
        INTO MST-ID MST-NAME MST-TYPE WS-AMOUNT-TXT WS-DUE-TXT MST-STATUS
    END-UNSTRING
    COMPUTE MST-AMOUNT = FUNCTION NUMVAL(WS-AMOUNT-TXT)
    COMPUTE MST-DUE-DATE = FUNCTION NUMVAL(WS-DUE-TXT)

    WRITE F-MST-REC FROM MST-REC
        INVALID KEY DISPLAY "DUPLICATE ID " MST-ID
        NOT INVALID KEY ADD 1 TO WS-COUNT
    END-WRITE.
